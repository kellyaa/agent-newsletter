---
import TagChip from "./TagChip.astro";

interface MonthEntry {
  key: string;
  label: string;
  count: number;
  href: string;
}

interface Props {
  issues: any[];
  months: MonthEntry[];
  currentMonth: string;
}

const { issues, months, currentMonth } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const DOW = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];
const MON = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

function parseISODate(s: string) {
  const [y, m, d] = s.split("-").map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d, 12));
  return { dow: DOW[dt.getUTCDay()], mon: MON[dt.getUTCMonth()], day: String(d) };
}

function countsString(m: {
  items_featured_papers: number;
  items_featured_news: number;
  items_featured_blogs: number;
  items_appendix: number;
}) {
  const parts: string[] = [];
  if (m.items_featured_papers > 0) parts.push(`${m.items_featured_papers} ${m.items_featured_papers === 1 ? "paper" : "papers"}`);
  if (m.items_featured_news > 0) parts.push(`${m.items_featured_news} news`);
  if (m.items_featured_blogs > 0) parts.push(`${m.items_featured_blogs} ${m.items_featured_blogs === 1 ? "blog" : "blogs"}`);
  if (m.items_appendix > 0) parts.push(`${m.items_appendix} appendix`);
  return parts.join(" · ");
}
---
<div class="month-view">
  <aside class="month-nav" aria-label="Browse by month">
    <h2 class="month-nav__heading">Archive</h2>
    <ol class="month-nav__list">
      {months.map((m) => (
        <li>
          <a
            href={`${base}${m.href}`}
            class={`month-nav__item${m.key === currentMonth ? " month-nav__item--current" : ""}`}
            aria-current={m.key === currentMonth ? "page" : undefined}
          >
            <span class="month-nav__label">{m.label}</span>
            <span class="month-nav__count">{m.count}</span>
          </a>
        </li>
      ))}
    </ol>
  </aside>
  <div class="month-view__main">
    <ol class="timeline">
      {issues.map((issue) => {
        const m = issue.data.metadata;
        const top = [...issue.data.featured].sort((a: any, b: any) => b.score - a.score).slice(0, 3);
        const tags = [...new Set(issue.data.featured.flatMap((f: any) => f.tags))].slice(0, 6);
        const dt = parseISODate(issue.data.date);
        const counts = countsString(m);
        return (
          <li class="timeline__item">
            <div class="timeline__rail" aria-hidden="true">
              <span class="timeline__dot"></span>
            </div>
            <article class="timeline__card">
              <header class="timeline__date">
                <span>{dt.dow}</span> · <span>{dt.mon} {dt.day}</span>
              </header>
              {issue.data.theme && (
                <p class="timeline__theme">{issue.data.theme}</p>
              )}
              {top.length > 0 && (
                <ul class="timeline__featured">
                  {top.map((f: any) => (
                    <li><a href={f.url} rel="noopener">{f.title}</a></li>
                  ))}
                </ul>
              )}
              <footer class="timeline__foot">
                <div class="timeline__meta">
                  {counts && <span class="timeline__counts">{counts}</span>}
                  {tags.length > 0 && (
                    <div class="tag-list">
                      {tags.map((t) => <TagChip label={t as string} />)}
                    </div>
                  )}
                </div>
                <a class="timeline__more" href={`${base}/issues/${issue.id}/`}>Read issue →</a>
              </footer>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</div>
