---
import { safeHref } from "../scripts/safe-href";
import { SECTIONS, SECTION_DISPLAY, type Section } from "../scripts/sections";

interface AppendixItem {
  id: string;
  section: Section;
  source: string;
  url: string;
  title: string;
}
interface Props {
  appendix: Record<Section, AppendixItem[]>;
}
const { appendix } = Astro.props;
const total = SECTIONS.reduce((n, key) => n + appendix[key].length, 0);
const groups = SECTIONS.map((key) => ({ key, label: SECTION_DISPLAY[key].label }));
---
{total > 0 && (
  <details class="appendix">
    <summary>{total} more items the ranker flagged but didn't feature</summary>
    <div class="appendix__body">
      {groups.map((g) => (
        appendix[g.key].length > 0 && (
          <section class="appendix__group">
            <h4 class="appendix__group-title">{g.label}</h4>
            <ul class="appendix__list">
              {appendix[g.key].map((it) => (
                <li>
                  <a href={safeHref(it.url)} rel="noopener noreferrer external">{it.title}</a>
                  <span class="appendix__source">{it.source}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      ))}
    </div>
  </details>
)}
