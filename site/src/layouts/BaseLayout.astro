---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "A daily, opinionated digest on building and running AI agents." } = Astro.props;
const baseUrl = import.meta.env.BASE_URL || "/";
const searchUrl = baseUrl.endsWith("/") ? `${baseUrl}search/` : `${baseUrl}/search/`;
const rssUrl = baseUrl.endsWith("/") ? `${baseUrl}rss.xml` : `${baseUrl}/rss.xml`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link rel="alternate" type="application/rss+xml" title="AI Agents Daily" href={rssUrl} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href={baseUrl}>AI Agents Daily</a>
        <span class="site-header__tagline">for engineers who build and run agents</span>
        <a class="site-header__search" href={searchUrl}>Search</a>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>AI Agents Daily — automated digest, opinions sharpened by Claude</span>
        <span>updated daily ~07:00 PT · <a href={rssUrl}>RSS</a></span>
      </div>
    </footer>
  </body>
</html>
