---
import "../styles/global.css";
import { UMBRELLA_NAME, UMBRELLA_DESCRIPTION } from "../scripts/editions";

interface Props {
  title: string;
  description?: string;
  /** The edition this page belongs to. Omit on umbrella pages (the homepage). */
  edition?: { slug: string; name: string; tagline: string };
}
const { title, edition } = Astro.props;
const description = Astro.props.description ?? edition?.tagline ?? UMBRELLA_DESCRIPTION;
const baseUrl = import.meta.env.BASE_URL || "/";
const trimmedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
const brandName = edition?.name ?? UMBRELLA_NAME;
// Umbrella pages link to the site root exactly as the base was configured;
// edition pages link to the edition front page.
const homeHref = baseUrl;
const brandHref = edition ? `${trimmedBase}/${edition.slug}/` : baseUrl;
const searchUrl = edition ? `${trimmedBase}/${edition.slug}/search/` : undefined;
const rssUrl = edition ? `${trimmedBase}/${edition.slug}/rss.xml` : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Content-Security-Policy: limits XSS blast radius.
         script-src 'self' 'unsafe-inline': pagefind requires inline scripts for its search UI.
         'wasm-unsafe-eval': pagefind compiles its search index engine with
         WebAssembly.instantiate, which CSP3 blocks without it (no unsafe-eval needed).
         worker-src 'self': pagefind runs search in pagefind-worker.js; without it
         default-src 'none' blocks the Worker.
         style-src allows Google Fonts and rsms.me for Inter + JetBrains Mono.
         img-src allows data: URIs used by pagefind and https: for external images.
         See sec-check issue #167 for rationale. -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://rsms.me https://fonts.googleapis.com; font-src 'self' https://rsms.me https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" />
    {rssUrl && <link rel="alternate" type="application/rss+xml" title={brandName} href={rssUrl} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      {edition && (
        <div class="site-header__inner site-header__home-row">
          <a class="site-header__home" href={homeHref}>← {UMBRELLA_NAME}</a>
        </div>
      )}
      <div class="site-header__inner">
        <a class="site-header__brand" href={brandHref}>{brandName}</a>
        <span class="site-header__tagline">{edition?.tagline}</span>
        {searchUrl && <a class="site-header__search" href={searchUrl}>Search</a>}
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>{brandName} — automated digest, opinions sharpened by Claude</span>
        <span>
          updated daily ~07:00 PT
          {rssUrl && <> · <a href={rssUrl}>RSS</a></>}
        </span>
      </div>
    </footer>
  </body>
</html>
