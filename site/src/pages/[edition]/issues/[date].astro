---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FeaturedItem from "../../../components/FeaturedItem.astro";
import AppendixSection from "../../../components/AppendixSection.astro";
import ArchiveSidebar from "../../../components/ArchiveSidebar.astro";
import { loadRegistry, editionOf, issuesFor } from "../../../scripts/editions";
import { groupByMonth, buildArchive } from "../../../scripts/months";
import { SECTIONS, SECTION_DISPLAY, featuredCountKey } from "../../../scripts/sections";

export async function getStaticPaths() {
  const issues = await getCollection("issues");
  const editions = new Map(loadRegistry().listed.map((e) => [e.slug, e]));
  return issues.map((issue) => {
    const edition = editions.get(editionOf(issue));
    return {
      params: { edition: edition!.slug, date: issue.data.date },
      props: { issue, edition },
    };
  });
}

const { issue, edition } = Astro.props;
const { date, theme, featured, appendix, metadata } = issue.data;
const archive = buildArchive(
  groupByMonth(issuesFor(await getCollection("issues"), edition.slug)),
  edition.slug,
  date,
);

const sectionGroups = SECTIONS.map((key) => ({
  key,
  label: SECTION_DISPLAY[key].label,
  count: metadata[featuredCountKey(key)],
  items: featured.filter((i) => i.section === key),
}));
---
<BaseLayout title={`${date} — ${edition.name}`} description={theme || `${edition.name} issue for ${date}`} edition={edition}>
  <div class="month-view">
  <ArchiveSidebar months={archive} />
  <div class="month-view__main">
  <article data-pagefind-body data-pagefind-meta={`date:${date}`} data-pagefind-filter={`edition:${edition.slug}`}>
  <header class="issue-header">
    <div class="issue-header__date">{date}</div>
    <h1 class="issue-header__title">{edition.name}</h1>
    {theme && <p class="issue-header__theme">{theme}</p>}
    <div class="statbar" role="group" aria-label="Run statistics">
      {sectionGroups.map((g) => (
        <span class="statbar__item"><span class="statbar__num">{g.count}</span> {SECTION_DISPLAY[g.key].many}</span>
      ))}
      <span class="statbar__item"><span class="statbar__num">{metadata.items_appendix}</span> appendix</span>
      <span class="statbar__item"><span class="statbar__num">{metadata.items_considered}</span> considered</span>
    </div>
  </header>

  {sectionGroups.map((g) => (
    g.count > 0 && (
      <section class="section" id={g.key}>
        <header class="section__head">
          <h2 class="section__title">{g.label}</h2>
          <span class="section__count">{g.count}</span>
        </header>
        {g.items.map((item) => <FeaturedItem item={item} edition={edition.slug} />)}
      </section>
    )
  ))}

  <AppendixSection appendix={appendix} />
  </article>
  </div>
  </div>
</BaseLayout>
