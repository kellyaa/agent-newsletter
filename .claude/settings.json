{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run --extra test pytest:*)",
      "Bash(uv run scripts/check_edition.py:*)",
      "Bash(pnpm --prefix site install:*)",
      "Bash(pnpm --prefix site build:*)",
      "Bash(pnpm --prefix site test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
