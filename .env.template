# LLM endpoint configuration for rank.py and write.py.
#
# Copy this file to .env and fill in your values. .env is gitignored.
#   cp .env.template .env
#
# Any OpenAI-compatible endpoint works: api.openai.com, vLLM, llama.cpp,
# LM Studio, Together, Fireworks, OpenRouter, Groq, internal endpoints, etc.

# Base URL of the chat-completions endpoint (no trailing slash).
LLM_BASE_URL=https://api.openai.com/v1

# Bearer token. Some local servers accept any non-empty value.
LLM_API_KEY=replace-me

# Model ids interpreted by the endpoint above.
RANKER_MODEL=gpt-4o-mini
WRITER_MODEL=gpt-4o-mini

# Per-call timeouts in seconds. Defaults match what the scripts use.
# RANKER_TIMEOUT_S=1800
# WRITER_TIMEOUT_S=1200

# Max completion tokens per LLM call. Lower this if your endpoint has a
# smaller context or completion limit.
# RANKER_MAX_TOKENS=32000
# WRITER_MAX_TOKENS=16000

# Optional: extra headers sent on every LLM request, as a JSON object.
# Use this for endpoints that require additional auth/routing headers
# beyond the bearer token.
#
# Example (internal RITS-fronted endpoint):
#   LLM_EXTRA_HEADERS={"RITS_API_KEY": "your-rits-key"}
#
# Example (multi-tenant routing):
#   LLM_EXTRA_HEADERS={"X-Tenant-Id": "abc"}
#
# LLM_EXTRA_HEADERS=

# Optional: fallback bearer token, used only if LLM_API_KEY is unset.
# OPENAI_API_KEY=

# Optional: structured-output mode. json_schema (default) | json_object | none.
# Set json_object if your endpoint 400s on json_schema (e.g. LiteLLM-fronted
# Bedrock Claude).
# LLM_RESPONSE_FORMAT=json_schema

# Optional: on a parse/truncation retry, ask LiteLLM to bypass its response
# cache (default 1). Set 0 for endpoints that reject unknown request-body params.
# LLM_RETRY_NO_CACHE=1

# Optional: Reddit app-only OAuth for the reddit sources. Reddit blocks
# unauthenticated top.json (HTTP 403). Create a "script" app at
# https://www.reddit.com/prefs/apps and set the id and secret. When either is
# unset, the reddit sources are skipped with one info line per run.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Reddit username used in the required User-Agent (by /u/<name>). Optional.
# REDDIT_USERNAME=
